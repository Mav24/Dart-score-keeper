<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DartScoreKeeper.ViewModels"
             xmlns:models="clr-namespace:DartScoreKeeper.Models"
             x:Class="DartScoreKeeper.Views.GamePage"
             x:DataType="viewmodels:GameViewModel"
             Title="{Binding GameTitle}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Score Display Area -->
        <ScrollView Grid.Row="0" MaximumHeightRequest="200">
            <VerticalStackLayout Padding="10" Spacing="5">
                
                <!-- Current Player and Dart -->
                <Label Text="{Binding CurrentPlayer.Name}" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding CurrentDartText}" 
                       FontSize="18"
                       HorizontalOptions="Center"/>
                
                <!-- Player Scores -->
                <CollectionView ItemsSource="{Binding Players}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Player">
                            <Grid ColumnDefinitions="*,Auto" Padding="5" Margin="5,2">
                                <Label Text="{Binding Name}" 
                                       FontSize="16"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding Score}" 
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <!-- Current Turn Scores -->
                <Label Text="Current Turn:" FontSize="14" Margin="0,10,0,0"/>
                <CollectionView ItemsSource="{Binding CurrentTurnScores}" 
                              ItemsLayout="HorizontalListLayout">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DartScore">
                            <Label Text="{Binding .}" 
                                   FontSize="14"
                                   Margin="5,0"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Dartboard Area -->
        <ContentView Grid.Row="1" x:Name="DartboardContainer">
            <AbsoluteLayout x:Name="DartboardLayout" 
                          BackgroundColor="{StaticResource Gray100}">
                
                <!-- This will be dynamically populated with dartboard graphics -->
                <Label Text="Tap dartboard sections to register scores"
                       AbsoluteLayout.LayoutBounds="0.5,0.5,200,40"
                       AbsoluteLayout.LayoutFlags="PositionProportional"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                
            </AbsoluteLayout>
        </ContentView>
        
        <!-- Quick Score Buttons -->
        <ScrollView Grid.Row="2" Orientation="Horizontal">
            <HorizontalStackLayout Padding="10" Spacing="5">
                <Button Text="MISS" Clicked="OnMissClicked" WidthRequest="60"/>
                <Button Text="S1" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S2" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S3" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S4" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S5" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S6" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S7" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S8" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S9" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S10" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S11" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S12" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S13" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S14" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S15" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S16" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S17" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S18" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S19" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="S20" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D1" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D2" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D3" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D4" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D5" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D6" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D7" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D8" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D9" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D10" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D11" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D12" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D13" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D14" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D15" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D16" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D17" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D18" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D19" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="D20" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T1" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T2" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T3" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T4" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T5" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T6" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T7" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T8" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T9" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T10" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T11" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T12" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T13" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T14" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T15" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T16" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T17" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T18" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T19" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="T20" Clicked="OnScoreClicked" WidthRequest="60"/>
                <Button Text="BULL" Clicked="OnBullClicked" WidthRequest="60"/>
                <Button Text="OUTER" Clicked="OnOuterBullClicked" WidthRequest="60"/>
                <Button Text="Back" Command="{Binding GoBackCommand}" WidthRequest="80"/>
            </HorizontalStackLayout>
        </ScrollView>
        
    </Grid>

</ContentPage>
